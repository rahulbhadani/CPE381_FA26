\mode<presentation>

\RequirePackage[sfdefault]{carlito}
\RequirePackage{caladea}
\renewcommand{\familydefault}{\sfdefault}

\RequirePackage{graphicx,sintefcolor}

% Settings
\usetheme{Madrid}
\useinnertheme{circles}

\usefonttheme{RedVelvet}
\usecolortheme{RedVelvet}
\useinnertheme{RedVelvet}

\RequirePackage{etoolbox}
\RequirePackage{tikz}

% ===== Space optimization: remove headline, compact footline =====
% Remove the section navigation headline to reclaim vertical space
\setbeamertemplate{headline}{}

% Compact single-line footline
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{author in head/foot}%
      \usebeamerfont{author in head/foot}\insertshortauthor
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
      \usebeamerfont{title in head/foot}\insertshorttitle
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,right]{date in head/foot}%
      \usebeamerfont{date in head/foot}\insertshortdate{}\hspace*{2em}
      \insertframenumber{} / \inserttotalframenumber\hspace*{2ex}
    \end{beamercolorbox}}%
  \vskip0pt%
}

\hypersetup{
    colorlinks=true,
    urlcolor=accentTeal,
    citecolor=accentTeal,
    filecolor=accentTeal
}

% Font: Carlito (Calibri clone) is now the default sans-serif.
% FiraSans has been removed for a cleaner, more traditional academic look.

\mode<all>