% Create custom section page template
\setbeamertemplate{section page}{%
  \begin{tikzpicture}[remember picture,overlay]
    % Background elements
    \fill[primaryNavy] (current page.north west) rectangle ([yshift=-3cm]current page.north east);
    \fill[accentTeal,opacity=0.3] (current page.south west) rectangle ([yshift=3cm]current page.south east);
    
    % Decorative elements
    \draw[line width=2pt,accentTeal] ([xshift=1cm,yshift=-3.5cm]current page.north west) -- ([xshift=9cm,yshift=-3.5cm]current page.north west);
    
    % Binary code design element (representing assembly)
    \foreach \i in {1,...,20} {
      \foreach \j in {1,...,3} {
        \node[text=accentTeal!40,font=\tiny] at ([xshift=\i*0.5cm,yshift=-6cm-\j*0.5cm]current page.north west) {\pgfmathparse{int(random(0,1))}\pgfmathresult};
      }
    }
    
    % Main title - using \insertsection to automatically get the current section title
    \node[text=white,font=\bfseries\LARGE,align=center] at (current page.north) [yshift=-1.5cm] {\insertsection};
    
    
    % Visual elements suggesting ARM architecture
    \draw[line width=1.5pt,accentTeal] ([xshift=10cm,yshift=-4cm]current page.north east) -- ([xshift=10cm,yshift=-7cm]current page.north east);
    \draw[line width=1.5pt,accentTeal] ([xshift=10cm,yshift=-5cm]current page.north east) -- ([xshift=12cm,yshift=-5cm]current page.north east);
    \draw[line width=1.5pt,accentTeal] ([xshift=10cm,yshift=-6cm]current page.north east) -- ([xshift=11cm,yshift=-6cm]current page.north east);
    
    % Stylized register representation
    \node[rectangle,fill=accentTeal!20,minimum width=3cm,minimum height=1cm,draw=accentTeal,thick] at ([xshift=-2cm,yshift=-5cm]current page.center) {0x00FF00FF};
    \node[rectangle,fill=accentTeal!10,minimum width=3cm,minimum height=1cm,draw=accentTeal,thick] at ([xshift=-2cm,yshift=-6.5cm]current page.center) {0xABCD1234};
  \end{tikzpicture}
}

% Create custom subsection page template
\setbeamertemplate{subsection page}{%
  \begin{tikzpicture}[remember picture,overlay]
    % Background elements - more subtle than section
    \fill[primaryNavy!60] (current page.north west) rectangle ([yshift=-2cm]current page.north east);
    \fill[accentTeal,opacity=0.15] (current page.south west) rectangle ([yshift=2cm]current page.south east);
    
    % Decorative elements - smaller scale
    \draw[line width=1.5pt,accentTeal] ([xshift=2cm,yshift=-2.5cm]current page.north west) -- ([xshift=7cm,yshift=-2.5cm]current page.north west);
    
    % Subsection indicator dots
    \foreach \i in {0,1,2} {
      \fill[accentTeal] ([xshift=1cm+\i*0.5cm,yshift=-3cm]current page.north west) circle (3pt);
    }
    
    % Simplified binary pattern - fewer elements
    \foreach \i in {1,...,15} {
      \foreach \j in {1,...,2} {
        \node[text=accentTeal!30,font=\scriptsize] at ([xshift=\i*0.6cm,yshift=-7cm-\j*0.4cm]current page.north west) {\pgfmathparse{int(random(0,1))}\pgfmathresult};
      }
    }
    
    % Section title (smaller, above subsection)
    \node[text=accentTeal!80,font=\bfseries\normalsize,align=center] at (current page.north) [yshift=-0.8cm] {\insertsection};
    
    % Subsection title (main focus)
    \node[text=white,font=\bfseries\Large,align=center] at (current page.north) [yshift=-1.8cm] {\insertsubsection};
    
    % Connector line between section and subsection
    \draw[line width=1pt,white,opacity=0.7] ([yshift=-1.2cm]current page.north) -- ([yshift=-1.4cm]current page.north);
    
    % Simplified ARM-style elements - right side
    \draw[line width=1pt,accentTeal!80] ([xshift=9cm,yshift=-3.5cm]current page.north east) -- ([xshift=9cm,yshift=-5.5cm]current page.north east);
    \draw[line width=1pt,accentTeal!80] ([xshift=9cm,yshift=-4cm]current page.north east) -- ([xshift=11cm,yshift=-4cm]current page.north east);
    
    % Single register representation - smaller
    \node[rectangle,fill=accentTeal!15,minimum width=2.5cm,minimum height=0.8cm,draw=accentTeal!60,thick] at ([xshift=-1.5cm,yshift=-4.5cm]current page.center) {\small 0x1A2B3C4D};
    
    % Progress indicator (optional - shows subsection within section)
    \node[text=accentTeal!60,font=\small] at ([xshift=-8cm,yshift=8cm]current page.south east) {\thesection.\thesubsection};
    
  \end{tikzpicture}
}

