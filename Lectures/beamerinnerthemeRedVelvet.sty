\newcommand{\noticebox}[1]{%
  \begin{tcolorbox}[
    colback=accentTeal!30,
    colframe=accentTeal!30,
    boxrule=0pt,
    arc=0pt,
    outer arc=0pt,
    left=6pt,
    right=6pt,
    top=3pt,
    bottom=3pt,
    boxsep=0pt,
    frame hidden
  ]
    \textbf{#1}
  \end{tcolorbox}
}

\newcommand{\msgbox}[2]{%
  \begin{tcolorbox}[
    colback=#1,
    colframe=#1,
    boxrule=0pt,
    arc=0pt,
    outer arc=0pt,
    left=6pt,
    right=6pt,
    top=3pt,
    bottom=3pt,
    boxsep=0pt,
    frame hidden
  ]
    \textbf{#2}
  \end{tcolorbox}
}

\newcommand{\linebox}[2]{%
  \begin{tcolorbox}[
    colback=#1,
    colframe=primaryNavy,
    boxrule=0.25pt,
    arc=0pt,
    outer arc=0pt,
    left=6pt,
    right=6pt,
    top=3pt,
    bottom=3pt,
    boxsep=0pt,
    frame hidden
  ]
    \textbf{#2}
  \end{tcolorbox}
}


\newtcolorbox{gradred}[1][]{
  enhanced,
  boxrule=0.5mm,
  arc=4mm, % Box corner rounding,
  borderline={4pt}{0pt}{accentTeal},  % Changed to use bordercolor
  overlay={
    \begin{tcbclipinterior}
      \shade[left color=lightTeal!30,right color=lightNavy!30] 
        (interior.south west) rectangle (interior.north east);
    \end{tcbclipinterior}
  },
  #1
}

